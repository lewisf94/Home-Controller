/*
 * secrets.h.example -- copy to secrets.h and fill in your values.
 * secrets.h is gitignored. Never commit real credentials.
 */
#pragma once

/* WiFi */
#define WIFI_SSID     "your_ssid"
#define WIFI_PASSWORD "your_password"

/* Home Assistant WebSocket API.
 * HA_HOST: local IP or hostname of your HA instance (no http:// prefix).
 * HA_PORT: 8123 for HTTP, 443 for HTTPS. */
#define HA_HOST   "192.168.1.100"
#define HA_PORT   8123
#define HA_TOKEN  "your_long_lived_access_token"

/* Music Assistant media_player entity to subscribe to.
 * e.g. "media_player.music_assistant_spotify" */
#define HA_ENTITY "media_player.your_entity_id"

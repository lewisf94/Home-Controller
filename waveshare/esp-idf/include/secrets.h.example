/*
 * Copy this file to secrets.h (in the same directory) and fill in your
 * own values. secrets.h is gitignored so credentials never leave your
 * machine.
 *
 * Spotify creds come from a one-time OAuth dance on a desktop:
 *   - Create an app at https://developer.spotify.com/dashboard
 *   - Authorise it once with scopes user-read-playback-state +
 *     user-modify-playback-state and exchange the code for a refresh token
 *   - The refresh token is long-lived; the access token is rotated by
 *     spotify_refresh_access_token() at runtime.
 */

#pragma once

#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#define SPOTIFY_CLIENT_ID     "YOUR_SPOTIFY_CLIENT_ID"
#define SPOTIFY_CLIENT_SECRET "YOUR_SPOTIFY_CLIENT_SECRET"
#define SPOTIFY_REFRESH_TOKEN "YOUR_SPOTIFY_REFRESH_TOKEN"

/* Optional: control a Sonos directly over your LAN. Spotify treats Sonos as a
 * "restricted" device and refuses Web API transport commands, so when playback
 * is on the Sonos the controller talks to it over UPnP instead. Controls
 * play/pause/next/prev/seek/volume of what's already playing; it does NOT start
 * albums on the Sonos (see docs/P4-TODO.md). Leave both undefined to disable.
 *
 * One speaker -- any restricted device routes to this IP
 * (Sonos app -> Settings -> System -> About for the IP):
 */
// #define SONOS_HOST "192.168.1.50"

/* Several speakers / multiple Sonos systems -- map each speaker's
 * Spotify-reported NAME (printed in the serial "now playing: ... @<name>" log)
 * to its LAN IP. Used instead of SONOS_HOST when defined. S1 vs S2 doesn't
 * matter -- the UPnP control is identical, only the IP differs: */
// #define SONOS_DEVICES                       \
//     { "Living Room", "192.168.1.50" },      \
//     { "Bedroom",     "192.168.1.51" }

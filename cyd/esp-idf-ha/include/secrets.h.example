/*
 * Copy this file to secrets.h (in the same directory) and fill in your own
 * values. secrets.h is gitignored so credentials never leave your machine.
 *
 * This is the HOME ASSISTANT build. It talks to HA over the local-network
 * WebSocket API (no Spotify OAuth on the device). You need:
 *   - HA_HOST   : your Home Assistant IP or hostname (static IP recommended)
 *   - HA_PORT   : usually 8123
 *   - HA_TOKEN  : a Long-Lived Access Token (HA profile -> Security -> create)
 *   - HA_ENTITY : the Music Assistant media_player entity to control,
 *                 e.g. "media_player.ma_living_room"
 */

#pragma once

#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#define HA_HOST    "192.168.1.50"
#define HA_PORT    8123
#define HA_TOKEN   "YOUR_HA_LONG_LIVED_TOKEN"
#define HA_ENTITY  "media_player.ma_your_player"

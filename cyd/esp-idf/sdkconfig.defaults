CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# LVGL 9.5.0 has an unconditional compile of lv_observer.c whose required
# types are only declared when LV_USE_OBSERVER is enabled. Turn it on so
# the types are visible. We don't use the Observer API directly; the cost
# is a few KB of code.
CONFIG_LV_USE_OBSERVER=y

.pio
.vscode/
.DS_Store

# Claude Code per-machine local settings (permission allowlist; not for sharing)
.claude/settings.local.json
*.swp
*.bak
*.orig
*.obj
*.o
*.a
*.lib
*.so
*.dylib
*.exe
*.bin
*.hex
archive/

# Album art (personal/copyright - do not commit)
scripts/input_albums/
scripts/sd_card_albums/
cyd/platformio/src/album_art/album_*.h

# Master album list (personal choices). Single source of truth for album
# metadata; scripts/gen_albums.py regenerates the committed albums.c/.cpp from
# it. The generated source files ARE committed; this input file (and any
# backups of it) are not.
spotify-albums-list*.txt

# Python bytecode cache (scripts/)
__pycache__/
*.pyc

# User credentials
cyd/platformio/include/secrets.h
cyd/esp-idf/include/secrets.h
cyd/esp-idf-ha/include/secrets.h
waveshare/esp-idf/include/secrets.h
scripts/album_preview.png

# spotipy token cache written by get_spotify_token.py (contains the refresh token)
.cache
**/.cache

# PlatformIO build artefacts
cyd/platformio/.pio/

# IDF build artefacts
cyd/esp-idf/build/
cyd/esp-idf/managed_components/
cyd/esp-idf/sdkconfig
cyd/esp-idf/sdkconfig.old
cyd/esp-idf/dependencies.lock

# IDF (HA build) artefacts
cyd/esp-idf-ha/build/
cyd/esp-idf-ha/managed_components/
cyd/esp-idf-ha/sdkconfig
cyd/esp-idf-ha/sdkconfig.old
cyd/esp-idf-ha/dependencies.lock

# Waveshare ESP32-P4 (non-HA) build artefacts. NOTE: components/ is vendored
# source (the board BSP) and IS committed; only managed_components/ is ignored.
waveshare/esp-idf/build/
waveshare/esp-idf/managed_components/
waveshare/esp-idf/sdkconfig
waveshare/esp-idf/sdkconfig.old
waveshare/esp-idf/dependencies.lock

# Waveshare ESP32-P4 (HA) build artefacts. Same rule: vendored components/
# are committed (shared via esp-idf/components/), only managed ones are not.
waveshare/esp-idf-ha/build/
waveshare/esp-idf-ha/managed_components/
waveshare/esp-idf-ha/sdkconfig
waveshare/esp-idf-ha/sdkconfig.old
waveshare/esp-idf-ha/dependencies.lock
# HA credentials (same pattern as non-HA and CYD builds).
waveshare/esp-idf-ha/include/secrets.h

# EIM (ESP-IDF Installation Manager) machine-local config
eim_config.toml

# KiCad transient files. The project files themselves (.kicad_pro,
# .kicad_sch, .kicad_pcb, sym-lib-table, fp-lib-table) are committed.
*-backups/
_autosave-*
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
*.lck

# Waveshare demo repo clone used for Step-0 board validation (not part of the project)
waveshare-test/

# VS Code "Local History" extension snapshots (editor-local, not project files)
.history/
